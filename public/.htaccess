# Configuración para Hostinger (Apache / LiteSpeed).

# Página de error para direcciones que no existen.
ErrorDocument 404 /404.html

# Caché: los archivos de _astro llevan una huella en el nombre y nunca cambian.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|avif|webp|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# Compresión de texto.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
