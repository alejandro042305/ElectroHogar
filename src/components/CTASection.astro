---
import Button from './Button.astro';
const {
  title = '¿Necesitas ayuda con tus electrodomésticos?',
  text = 'Estamos listos para ayudarte. Contáctanos y solicita tu servicio técnico.',
  label = 'Hablar por WhatsApp',
  wa = 'general',
  flush = false,
} = Astro.props;
---
<section class:list={['cta', { 'cta--flush': flush }]}>
  <div class="container">
    <div class="cta__panel" data-reveal>
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <Button wa={wa} variant="white">{label}</Button>
    </div>
  </div>
</section>
