---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { testimonials } from '../config/content.js';
---
<section class="section section--gray">
  <div class="container" data-carousel>
    <div class="carousel-head">
      <SectionHeading eyebrow="Testimonios" title="Lo que dicen nuestros clientes" />
      <div class="carousel-controls">
        <button class="round-btn" type="button" aria-label="Testimonio anterior" data-carousel-prev><Icon name="chevron-left" size={22} /></button>
        <button class="round-btn" type="button" aria-label="Testimonio siguiente" data-carousel-next><Icon name="chevron-right" size={22} /></button>
      </div>
    </div>
    <ul class="carousel-track" data-carousel-track tabindex="0" aria-label="Testimonios de clientes">
      {testimonials.map((t) => (
        <li class="testimonial">
          <span class="stars" aria-hidden="true">
            {Array.from({ length: 5 }, () => <Icon name="star" size={18} />)}
          </span>
          <blockquote>“{t.text}”</blockquote>
          <p class="testimonial__author"><strong>{t.name}</strong><span>{t.city}</span></p>
        </li>
      ))}
    </ul>
    <div class="carousel-dots">
      {testimonials.map((t, i) => (
        <button type="button" aria-label={`Ir al testimonio ${i + 1}`} data-carousel-dot></button>
      ))}
    </div>
  </div>
</section>
