---
import Button from './Button.astro';
import Checklist from './Checklist.astro';
import SectionHeading from './SectionHeading.astro';
---
<section class="section" id="cobertura">
  <div class="container split">
    <div class="split__text">
      <SectionHeading eyebrow="Cobertura" title="Estamos cerca de ti" text="Prestamos servicio técnico a domicilio en Bogotá y municipios cercanos." />
      <div data-reveal>
        <Checklist items={['Atención directamente en tu hogar', 'Confirma tu zona antes de agendar']} />
        <div class="btn-row">
          <Button wa="cobertura">Consultar cobertura por WhatsApp</Button>
        </div>
      </div>
    </div>
    <div class="coverage-map" data-reveal>
      <svg viewBox="0 0 560 440" role="img" aria-label="Esquema de cobertura: Bogotá en el centro y municipios cercanos alrededor">
        <defs>
          <pattern id="street-grid" width="44" height="44" patternUnits="userSpaceOnUse" patternTransform="rotate(-18)">
            <path d="M44 0H0v44" fill="none" stroke="#D9D6E8" stroke-width="1" />
          </pattern>
          <radialGradient id="area" cx="50%" cy="50%" r="50%">
            <stop offset="0" stop-color="#7C3AED" stop-opacity=".30" />
            <stop offset=".65" stop-color="#A78BFA" stop-opacity=".18" />
            <stop offset="1" stop-color="#A78BFA" stop-opacity=".04" />
          </radialGradient>
        </defs>
        <rect width="560" height="440" fill="#F3F4F6" />
        <rect width="560" height="440" fill="url(#street-grid)" />
        <path d="M-10 330C90 300 150 340 230 300s130-130 340-150" fill="none" stroke="#fff" stroke-width="9" />
        <path d="M120-10c20 90 90 150 120 230s10 150 40 240" fill="none" stroke="#fff" stroke-width="7" />
        <circle cx="280" cy="220" r="196" fill="url(#area)" />
        <circle cx="280" cy="220" r="196" fill="none" stroke="#A78BFA" stroke-width="1.5" stroke-dasharray="4 8" />
        <circle cx="280" cy="220" r="104" fill="#7C3AED" fill-opacity=".14" stroke="#7C3AED" stroke-width="1.5" />
        <circle class="coverage-map__ping" cx="280" cy="220" r="26" fill="#7C3AED" fill-opacity=".3" />
        <path d="M280 228s-30-30-30-52a30 30 0 0 1 60 0c0 22-30 52-30 52Z" fill="#7C3AED" transform="translate(0 -6)" />
        <circle cx="280" cy="170" r="11" fill="#fff" />
        <g font-family="Poppins, sans-serif" text-anchor="middle">
          <rect x="232" y="240" width="96" height="32" rx="16" fill="#1F2937" />
          <text x="280" y="261" fill="#fff" font-size="15" font-weight="600">Bogotá</text>
          <rect x="190" y="372" width="180" height="30" rx="15" fill="#fff" />
          <text x="280" y="392" fill="#1F2937" font-size="13.5" font-weight="500">Municipios cercanos</text>
        </g>
      </svg>
    </div>
  </div>
</section>
