---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import logoDark from '../assets/brand/logo-dark.png';
import { company } from '../config/company.js';

/** Logo de la marca. `dark` usa la versión clara con lema, para fondos oscuros. */
const { dark = false } = Astro.props;
---
<Image
  class:list={['logo', { 'logo--dark': dark }]}
  src={dark ? logoDark : logo}
  alt={company.name}
  height={dark ? 72 : 46}
  densities={[1, 2]}
  format="webp"
  quality={90}
  loading="eager"
/>
