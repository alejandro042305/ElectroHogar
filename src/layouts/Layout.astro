---
import '@fontsource-variable/inter/wght.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '../styles/variables.css';
import '../styles/globals.css';
import '../styles/components.css';

import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { company } from '../config/company.js';
import { absolute, link, stripBase } from '../config/paths.js';
import { localBusinessSchema } from '../config/schema.js';

const { title, description, wa = 'general', schema = [], noindex = false } = Astro.props;
const canonical = absolute(stripBase(Astro.url.pathname));
const ogImage = absolute('/og-image.jpg');
const jsonLd = [localBusinessSchema, ...schema];
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#7C3AED" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={link('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={link('/apple-touch-icon.png')} />

    <script is:inline>document.documentElement.classList.add('js');</script>
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Navbar wa={wa} />
    <main id="contenido"><slot /></main>
    <Footer />
    <WhatsAppButton wa={wa} />
    <script src="../scripts/main.js"></script>
  </body>
</html>
