---
import BenefitGrid from '../components/BenefitGrid.astro';
import Button from '../components/Button.astro';
import CTASection from '../components/CTASection.astro';
import Checklist from '../components/Checklist.astro';
import OtherServices from '../components/OtherServices.astro';
import PageHero from '../components/PageHero.astro';
import SplitBlock from '../components/SplitBlock.astro';
import { company } from '../config/company.js';
import { breadcrumbSchema, serviceSchema } from '../config/schema.js';
import Layout from '../layouts/Layout.astro';

const crumbs = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/servicios/' },
  { label: 'Aires acondicionados', href: '/aires-acondicionados/' },
];
const description =
  'Servicio técnico de aires acondicionados en Bogotá: asesoría, instalación, reparación y mantenimiento de equipos split, portátiles, de ventana y centrales.';

const benefits = [
  { icon: 'wind', title: 'Aire más limpio', text: 'La limpieza de filtros y serpentines mantiene el equipo en buen estado.' },
  { icon: 'gauge', title: 'Funcionamiento eficiente', text: 'Un equipo ajustado y calibrado trabaja mejor.' },
  { icon: 'search-check', title: 'Fallas detectadas a tiempo', text: 'La revisión periódica ayuda a identificar fugas y problemas eléctricos.' },
  { icon: 'timer', title: 'Mayor vida útil', text: 'El mantenimiento ayuda a prolongar la vida de tu equipo.' },
];
---
<Layout
  title={`Instalación y reparación de aires acondicionados en Bogotá | ${company.name}`}
  description={description}
  wa="aires"
  schema={[serviceSchema({ name: 'Instalación, reparación y mantenimiento de aires acondicionados', description, path: '/aires-acondicionados/' }), breadcrumbSchema(crumbs)]}
>
  <PageHero
    title="Instalación, reparación y mantenimiento de aires acondicionados"
    text="Soluciones técnicas para mantener tus equipos funcionando eficientemente."
    image="aire-serpentin"
    alt="Aire acondicionado tipo split instalado en la sala de un apartamento con vista a la ciudad"
    position="60% 40%"
    icon="snowflake"
    wa="aires"
    breadcrumbs={crumbs}
  />

  <SplitBlock
    eyebrow="Asesoría"
    title="Venta e instalación"
    image="aire-dormitorio"
    alt="Aire acondicionado tipo split instalado sobre la cama de un dormitorio moderno"
    position="60% 35%"
  >
    <p>Si necesitas un nuevo aire acondicionado, te asesoramos en la elección de la mejor opción según tus necesidades y el espacio disponible.</p>
    <div class="btn-row"><Button wa="aires">Pedir asesoría</Button></div>
  </SplitBlock>

  <SplitBlock
    gray
    reverse
    eyebrow="Reparación"
    title="Reparación"
    image="aire-reparacion"
    alt="Técnico revisando con manómetros la unidad exterior de un aire acondicionado en un balcón"
    position="40% 40%"
  >
    <p>Realizamos reparación de aires acondicionados con atención técnica especializada, repuestos adecuados y garantía.</p>
    <p>Atendemos estos tipos de equipos:</p>
    <ul class="chips">
      <li>Tipo split</li>
      <li>Portátiles</li>
      <li>De ventana</li>
      <li>Centrales</li>
    </ul>
  </SplitBlock>

  <SplitBlock
    eyebrow="Mantenimiento"
    title="Mantenimiento preventivo y correctivo"
    image="aire-filtro"
    alt="Técnico retirando el filtro de un aire acondicionado tipo split para limpiarlo"
    position="45% 35%"
  >
    <Checklist items={[
      'Limpieza y desinfección de filtros y serpentines.',
      'Revisión y ajuste del sistema de ventilación.',
      'Calibración del termostato.',
      'Verificación de fugas y nivel de gas refrigerante.',
      'Lubricación de componentes mecánicos.',
      'Inspección del sistema eléctrico y consumo energético.',
    ]} />
  </SplitBlock>

  <BenefitGrid eyebrow="Beneficios" title="Por qué hacer mantenimiento a tu aire acondicionado" items={benefits} lavender />

  <CTASection title="¿Necesitas ayuda con tu aire acondicionado?" text="Cuéntanos qué necesitas: instalación, reparación o mantenimiento." label="Solicitar servicio" wa="aires" />
  <OtherServices current="aires" />
</Layout>
